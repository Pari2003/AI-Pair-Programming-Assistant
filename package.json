{
  "name": "ai-pair-programming-assistant",
  "displayName": "AI Pair Programming Assistant",
  "description": "Agentic Write-Refactor-Test loop with telemetry-based tracking.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Machine Learning",
    "Programming Languages"
  ],
  "activationEvents": [
    "onCommand:aiAssistant.startTask"
  ],
  "publisher": "Pari2003",
  "repository": {
    "type": "git",
    "url": "https://github.com/Pari2003/AI-Pair-Programming-Assistant.git"
  },
  "license": "MIT",
  "icon": "icon.png",
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "aiAssistant.startTask",
        "title": "AI Assistant: Start Task"
      },
      {
        "command": "aiAssistant.showDashboard",
        "title": "AI Assistant: Show Telemetry Dashboard"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ai-assistant-sidebar",
          "title": "AI Pair Programming",
          "icon": "$(hubot)"
        }
      ]
    },
    "views": {
      "ai-assistant-sidebar": [
        {
          "id": "ai-assistant-chat",
          "name": "Chat Interface"
        }
      ]
    },
    "configuration": {
      "title": "AI Assistant Settings",
      "properties": {
        "aiAssistant.modelProvider": {
          "type": "string",
          "default": "Ollama",
          "enum": ["Ollama", "OpenAI", "Anthropic"],
          "description": "Select the LLM provider to use for the AI Assistant."
        },
        "aiAssistant.openaiApiKey": {
          "type": "string",
          "default": "",
          "description": "OpenAI API Key (required if OpenAI is selected as provider or for vector embeddings)."
        },
        "aiAssistant.openaiModel": {
          "type": "string",
          "default": "gpt-4o",
          "description": "The OpenAI model to use."
        },
        "aiAssistant.anthropicApiKey": {
          "type": "string",
          "default": "",
          "description": "Anthropic API Key (required if Anthropic is selected)."
        },
        "aiAssistant.anthropicModel": {
          "type": "string",
          "default": "claude-3-5-sonnet-20240620",
          "description": "The Anthropic model to use."
        },
        "aiAssistant.ollamaModel": {
          "type": "string",
          "default": "llama3.2:1b",
          "description": "The local Ollama model to use."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.1",
    "@types/node": "18.x",
    "@types/uuid": "^10.0.0",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^6.4.1",
    "@typescript-eslint/parser": "^6.4.1",
    "@vscode/test-cli": "^0.0.4",
    "@vscode/test-electron": "^2.3.4",
    "eslint": "^8.47.0",
    "ts-loader": "^9.4.4",
    "typescript": "^5.1.6",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "uuid": "^9.0.0",
    "zod": "^3.22.2"
  }
}
